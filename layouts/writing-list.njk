---
layout: base.njk
---
<header class="stack-tight">
  <h1>Blog</h1>
  {{ content | safe }}
</header>

{% if collections.posts.length %}
  {% set headingLevel = 2 %}
  <ul class="post-list stack-loose" role="list">
    {% for post in collections.posts %}
      <li>{% include "post-card.njk" %}</li>
    {% endfor %}
  </ul>
{% else %}
  <p>No posts yet. Check back soon.</p>
{% endif %}
