{% set _level = headingLevel or 3 %}
<article class="post-card">
  <h{{ _level }} class="post-card__title">
    <a href="{{ post.url }}">{{ post.data.title }}</a>
  </h{{ _level }}>
  <p class="post-card__meta">
    <time datetime="{{ post.data.date | isoDate }}">{{ post.data.date | readableDate }}</time>
  </p>
  <p class="post-card__description">{{ post.data.description }}</p>
</article>
