---
layout: base.njk
wide: true
isHome: true
bodyClass: home
---
<section class="hero hero--logo" aria-labelledby="brand">
  <h1 id="brand" class="visually-hidden">alankey.dev</h1>
  <img class="hero__logo" src="/assets/logo.svg" alt="" width="1000" height="600" decoding="async" fetchpriority="high">
  <div class="hero__intro">
    {{ content | safe }}
  </div>
  <nav class="hero__links" aria-label="Sections and elsewhere">
    <ul role="list">
      <li>
        <a href="/blog/">
          <svg class="hero__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3V4z"/>
            <path d="M9 9h7M9 13h7M9 17h4"/>
          </svg>
          <span>Blog</span>
        </a>
      </li>
      <li>
        <a href="{{ site.feed.path }}">
          <svg class="hero__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor">
            <path d="M5 3a16 16 0 0 1 16 16h-3A13 13 0 0 0 5 6V3zm0 7a9 9 0 0 1 9 9h-3a6 6 0 0 0-6-6v-3zm1.5 7a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5z"/>
          </svg>
          <span>RSS</span>
        </a>
      </li>
      <li>
        <a href="https://github.com/alankey-dev" rel="me noopener">
          <svg class="hero__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55v-1.92c-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.69 1.25 3.34.95.1-.74.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.95 10.95 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.41-5.25 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.66.79.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/>
          </svg>
          <span>GitHub</span>
        </a>
      </li>
      <li>
        <a href="https://bsky.app/profile/alankey.dev" rel="me noopener">
          <svg class="hero__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor">
            <path d="M6.4 4.2c2.6 1.8 5.4 5.4 6.4 7.4 1-2 3.8-5.6 6.4-7.4 1.9-1.3 4.9-2.3 4.9 1.2 0 .7-.4 5.9-.6 6.7-.7 2.9-3.6 3.6-6.2 3.2 4.6.8 5.7 3.4 3.2 6-4.7 4.9-6.8-1.3-7.3-2.9-.1-.3-.2-.4-.2-.3 0-.1-.1 0-.2.3-.5 1.6-2.6 7.8-7.3 2.9-2.5-2.6-1.4-5.2 3.2-6-2.6.4-5.5-.3-6.2-3.2C2.2 11.3 1.8 6.1 1.8 5.4c0-3.5 3-2.5 4.6-1.2z"/>
          </svg>
          <span>Bluesky</span>
        </a>
      </li>
      <li>
        <a href="mailto:hello@alankey.dev">
          <svg class="hero__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="5" width="18" height="14" rx="2"/>
            <path d="m4 7 8 6 8-6"/>
          </svg>
          <span>Email</span>
        </a>
      </li>
    </ul>
  </nav>
</section>

{% if collections.latestPosts.length %}
<section class="latest stack-loose">
  <h2 class="latest__title">Blog</h2>
  <ul class="post-list" role="list">
    {% for post in collections.latestPosts %}
      <li>{% include "post-card.njk" %}</li>
    {% endfor %}
  </ul>
  {% if collections.posts.length > collections.latestPosts.length %}
    <p class="latest__more"><a href="/blog/">All posts &rarr;</a></p>
  {% endif %}
</section>
{% endif %}
