        </a>
      </li>
      <li>
        <a href="https://bsky.app/profile/alankey.dev" rel="me noopener">
          <svg class="hero__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor">
            <path d="M6.4 4.2c2.6 1.8 5.4 5.4 6.4 7.4 1-2 3.8-5.6 6.4-7.4 1.9-1.3 4.9-2.3 4.9 1.2 0 .7-.4 5.9-.6 6.7-.7 2.9-3.6 3.6-6.2 3.2 4.6.8 5.7 3.4 3.2 6-4.7 4.9-6.8-1.3-7.3-2.9-.1-.3-.2-.4-.2-.3 0-.1-.1 0-.2.3-.5 1.6-2.6 7.8-7.3 2.9-2.5-2.6-1.4-5.2 3.2-6-2.6.4-5.5-.3-6.2-3.2C2.2 11.3 1.8 6.1 1.8 5.4c0-3.5 3-2.5 4.6-1.2z"/>
